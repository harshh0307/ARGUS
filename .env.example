# GitHub access (required for `argus pr` and the demo; scopes: repo, workflow).
# Either a classic PAT (GITHUB_TOKEN) or a GitHub App (three settings below).
GITHUB_TOKEN=

# GitHub App authentication (alternative to GITHUB_TOKEN).
# GITHUB_APP_PRIVATE_KEY is the PEM content (multiline, quotes around it in .env).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALL_ID=

# Secret for verifying GitHub webhook signatures (X-Hub-Signature-256).
WEBHOOK_SECRET=

# FastAPI server binding (uvicorn app.api.main:app).
API_HOST=0.0.0.0
API_PORT=8000

# Spec sources (github/rest-api-description repo)
GITHUB_SPEC_URL=https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json
GITHUB_OLD_SPEC_URL=https://raw.githubusercontent.com/github/rest-api-description/04fd6c592fc546217404b07e0b0e581fb00a963a/descriptions/api.github.com/api.github.com.json

# Where snapshots live
SNAPSHOT_DIR=data/snapshots

# Phase 2 persistence. Leave empty to run without a database.
# SQLite:  DATABASE_URL=sqlite:///data/argus.db
# Postgres: DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5432/argus
DATABASE_URL=

# Celery broker/result backend (Redis). Used by `argus worker` / `argus beat`.
REDIS_URL=redis://localhost:6379/0

# Base URL used by the scanner to recognize API calls
API_BASE_URL=https://api.github.com

# LLM for the fix agent (any OpenAI-compatible provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
FIX_MAX_ATTEMPTS=3

# Free-tier fallback when the primary LLM is rate-limited (429)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Authentication (required for API access)
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=change-me-in-production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WEBHOOK=30/minute
